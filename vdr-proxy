def sanitize_id(vdr_id):
    clean = re.sub(r'[^a-zA-Z0-9]', '_', vdr_id)
    clean = re.sub(r'_+', '_', clean).strip('_')
    return f"vdr_{clean}"

def clean_xml_string(text):
    """Removes invalid ASCII control characters and escapes HTML tags."""
    if not text:
        return ""
    # 9 = Tab, 10 = Linefeed, 13 = Carriage Return, >= 32 = Regular characters
    cleaned = "".join(ch for ch in text if ord(ch) >= 32 or ord(ch) in (9, 10, 13))
    return html.escape(cleaned)

def fetch_channels():
    """Connects to the VDR via Streamdev Server plugin and fetches channel information."""
    channels = {}
    try:
        vdr_url = f"{STREAMDEV_PROTOCOL}://{VDR_IP}:{STREAMDEV_PORT}/channels.m3u"
        print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Connecting upstream to VDR: {vdr_url}")
        req = urllib.request.Request(vdr_url, headers={f'User-Agent': '{USERAGENT}'})
        with urllib.request.urlopen(req, timeout=5) as response:
            m3u_content = response.read().decode('utf-8', errors='ignore')
        current_name = "Unknown Channel"
        for line in m3u_content.splitlines():
            line = line.strip()
            if line.startswith("#EXTINF"):
                parts = line.split(",", 1)
                if len(parts) == 2:
                    current_name = parts[1].strip()
            elif line.startswith("http"):
                match = re.search(r'/([^/]+)$', line)
                if match:
                    raw_id = match.group(1)
                    channels[raw_id] = current_name
    except Exception as e:
        print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Error fetching Streamdev M3U for EPG validation: {e}", file=sys.stderr)
    return channels

def modify_m3u_channels(original_m3u):
    lines = original_m3u.splitlines()
    new_m3u = ["#EXTM3U"]
    current_extinf = None
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#EXTM3U"):
            continue
        if line.startswith("#EXTINF"):
            current_extinf = line
        elif line.startswith("http"):
            match = re.search(r'/([^/]+)$', line)
            if match and current_extinf:
                raw_channel_id = match.group(1)
                clean_channel_id = sanitize_id(raw_channel_id)
                parts = current_extinf.split(",", 1)
                if len(parts) == 2:
                    meta, name = parts[0], parts[1]
                    current_extinf = f'{meta} tvg-id="{clean_channel_id}" tvg-name="{name}",{name}'
            if current_extinf:
                new_m3u.append(current_extinf)
                current_extinf = None
            if match:
                if PROXY_STREAM:
                    M3UPROTOCOL = PROXY_PROTOCOL
                    M3UIP = PROXY_IP
                    M3UPORT = PROXY_PORT
                else:
                    M3UPROTOCOL = VDR_PROTOCOL
                    M3UIP = VDR_IP
                    M3UPORT = STREAMDEV_PORT

                new_m3u.append(f"{M3UPROTOCOL}://{M3UIP}:{M3UPORT}/{STREAMDEV_STREAMTYPE}/{match.group(1)}")
            else:
                new_m3u.append(line)
    return "\n".join(new_m3u)

def fetch_epg_via_svdrp():
    """Connects to the VDR via SVDRP and fetches the complete EPG data stream."""
    lines = []
    try:
        # Open TCP socket connection to VDR SVDRP port
        print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Connecting upstream to VDR via SVDRP: {VDR_IP}:{SVDRP_PORT}")
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(SVDRP_TIMEOUT)
        s.connect((VDR_IP, SVDRP_PORT))
        
        # Read the initial welcome message from VDR (e.g., 220 ...)
        initial_resp = s.recv(4096).decode('utf-8', errors='ignore')
        
        # Send LSTE command to request all EPG entries
        s.sendall(b"LSTE\r\n")
        
        counter = 0
        buffer = ""
        while True:
            chunk = s.recv(65536).decode('utf-8', errors='ignore')
            if not chunk:
                break
            buffer += chunk
            
            # Process lines on-the-fly from buffer
            while "\n" in buffer:
                line, buffer = buffer.split("\n", 1)
                line = line.strip()
                if not line:
                    continue
                
                # SVDRP codes response status mapping:
                # If line ends with "End of EPG data", close connection and return received lines
                elif line.endswith("End of EPG data"):
                    # Safely close connection using QUIT command
                    s.sendall(b"QUIT\r\n")
                    s.close()
                    return lines
                # If line begins with 215, cut status code from line and append to lines
                elif line.startswith("215"):
                    # Strip the numeric response prefix (e.g., '215-' or '215 ')
                    vdr_line = line[4:]
                    lines.append(vdr_line)
                # if line begins with 4xx or 5xx status code, print error and return empty lines
                elif line.strip() and line.split()[0].isdigit() and int(line.split()[0]) >= 400:
                    # Error codes (4xx/5xx) from SVDRP
                    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] SVDRP returned error: {line}", file=sys.stderr)
                    return []
 
    except Exception as e:
        print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] SVDRP connection failed to {VDR_IP}:{SVDRP_PORT}: {e}", file=sys.stderr)
        return []

def parse_epg_data():
    """Converts the VDR EPG contents (from file or SVDRP) into standard XMLTV format."""
    channel_map = fetch_channels()
    epg_source_lines = []

    # Choose EPG ingest engine based on your config file
    if EPG_MODE == "svdrp":
        print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Fetching EPG data via SVDRP network interface...")
        epg_source_lines = fetch_epg_via_svdrp()
    else:
        print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Reading EPG data from local file path: {EPG_FILE}")
        if os.path.exists(EPG_FILE):
            with open(EPG_FILE, "r", encoding="utf-8", errors="ignore") as f:
                epg_source_lines = [line.strip() for line in f]

    # Process additional channel names discovered inside the EPG data stream
    for line in epg_source_lines:
        if line.startswith("C "):
            parts = line.split(" ", 2)
            if len(parts) >= 2:
                raw_id = parts[1].strip()
                if raw_id not in channel_map and len(parts) > 2:
                    channel_map[raw_id] = parts[2].strip()

    xml = ['<?xml version="1.0" encoding="utf-8" ?>']
    xml.append(f'<tv generator-info-name="{USERAGENT}">')
    
    for raw_id, ch_name in channel_map.items():
        clean_id = sanitize_id(raw_id)
        xml.append(f'  <channel id="{clean_id}">')
        xml.append(f'    <display-name>{clean_xml_string(ch_name)}</display-name>')
        xml.append('  </channel>')
        
    inside_event = False
    current_channel = None
    
    for line in epg_source_lines:
        if not line:
            continue
        
        parts = line.split(" ", 1)
        tag = parts[0].strip()
        content = parts[1].strip() if len(parts) > 1 else ""
        
        if tag == "C":
            c_parts = content.split(" ", 1)
            current_channel = c_parts[0].strip()
        elif tag == "E" and current_channel:
            inside_event = True
            e_parts = content.split(" ")
            if len(e_parts) >= 3:
                try:
                    start_ts = int(e_parts[1])
                    duration = int(e_parts[2])
                    end_ts = start_ts + duration
                    
                    # Get local timezone offset in +HHMM or -HHMM format
                    offset_sec = -time.timezone if (time.localtime().tm_isdst == 0) else -time.altzone
                    sign = '+' if offset_sec >= 0 else '-'
                    offset_min = abs(offset_sec) // 60
                    offset_str = f"{sign}{offset_min // 60:02d}{offset_min % 60:02d}"
                    start_str = datetime.fromtimestamp(start_ts).strftime('%Y%m%d%H%M%S') + f" {offset_str}"
                    end_str = datetime.fromtimestamp(end_ts).strftime('%Y%m%d%H%M%S') + f" {offset_str}"
                    
                    clean_ch_id = sanitize_id(current_channel)
                    xml.append(f'  <programme start="{start_str}" stop="{end_str}" channel="{clean_ch_id}">')
                except (ValueError, IndexError):
                    inside_event = False
                    continue
        elif tag == "T" and inside_event:
            xml.append(f'    <title lang="de">{clean_xml_string(content)}</title>')
        elif tag == "D" and inside_event:
            xml.append(f'    <desc lang="de">{clean_xml_string(content)}</desc>')
        elif tag == "e":
            if inside_event:
                xml.append('  </programme>')
                inside_event = False
                
    xml.append('</tv>')
    return "\n".join(xml)

class VDRProxyHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        
        client_ip = self.client_address[0]
        thread_name = threading.current_thread().name

        # Check authentication
        if ENABLE_AUTH:
            auth_header = self.headers.get('Authorization')
            authorized = False
            
            if auth_header and auth_header.startswith('Basic '):
                try:
                    # Space after 'Basic' is important; split and decode the credentials
                    encoded_credentials = auth_header.split(' ')[1].strip()
                    
                    # Decode Base64 and convert to string
                    decoded_bytes = base64.b64decode(encoded_credentials, validate=False)
                    decoded_credentials = decoded_bytes.decode('utf-8')
                    
                    # Split username and password
                    if ':' in decoded_credentials:
                        username, password = decoded_credentials.split(':', 1)
                        if username == AUTH_USERNAME and password == AUTH_PASSWORD:
                            authorized = True
                except Exception as e:
                    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] [{thread_name}] Auth-Error: {e}")
            
            if not authorized:
                # Send "401 Unauthorized" to force client to authenticate
                self.send_response(401)
                self.send_header('WWW-Authenticate', 'Basic realm="VDR Transcode Proxy"')
                self.send_header('Content-Type', 'text/plain; charset=utf-8')
                self.end_headers()
                self.wfile.write(b"401 Unauthorized - Credentials needed.")
                print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] [{thread_name}] Rejected Login from {client_ip}")
                return

        print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Incoming request from {self.client_address[0]} for path: {self.path}")
        if self.path == "/channels.m3u":
            try:
                vdr_url = f"{STREAMDEV_PROTOCOL}://{VDR_IP}:{STREAMDEV_PORT}/channels.m3u"
                print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Connecting upstream to VDR: {vdr_url}")
                req = urllib.request.Request(vdr_url, headers={f'User-Agent': '{USERAGENT}'})
                with urllib.request.urlopen(req) as response:
                    m3u_content = response.read().decode('utf-8', errors='ignore')
                modified_m3u = modify_m3u_channels(m3u_content)
                self.send_response(200)
                self.send_header('Content-Type', 'audio/x-mpegurl; charset=utf-8')
                self.end_headers()
                self.wfile.write(modified_m3u.encode('utf-8'))
            except Exception as e:
                self.send_error(500, f"M3U Error: {e}")
        elif self.path == "/epg.xml":
            try:
                epg_xml = parse_epg_data()
                self.send_response(200)
                self.send_header('Content-Type', 'application/xml; charset=utf-8')
                self.end_headers()
                self.wfile.write(epg_xml.encode('utf-8'))
            except Exception as e:
                self.send_error(500, f"EPG Error: {e}")
        elif self.path.startswith(f"/{STREAMDEV_STREAMTYPE}"):
            
            parsed_url = urlparse(self.path)
            query_params = parse_qs(parsed_url.query)
            path = parsed_url.path    
            # extract bitrate and video size from parameters, if provided
            vbitrate = query_params.get('vbitrate', [DEFAULT_VBITRATE])[0]
            abitrate = query_params.get('abitrate', [DEFAULT_ABITRATE])[0]
            vsize = query_params.get('vsize', [DEFAULT_VSIZE])[0]
            vcodec = query_params.get('vcodec', [DEFAULT_VCODEC])[0]
            # Construct the target URL on the VDR streamdev server
            # e.g., if client requests http://proxy:8080/TS/1, 
            # it fetches http://192.168.1.50:3000/TS/1
            vdr_url = f"{STREAMDEV_PROTOCOL}://{VDR_IP}:{STREAMDEV_PORT}{path}"
            
            if vbitrate != DEFAULT_VBITRATE or abitrate != DEFAULT_ABITRATE or vsize != DEFAULT_VSIZE:
                print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Transcoding using {vcodec}: vbitrate={vbitrate}, abitrate={abitrate}, vsize={vsize} for {self.client_address[0]}")
                # Create basic FFmpeg command to read from VDR streamdev and output to stdout
                cmd = [
                    'ffmpeg',
                    '-hide_banner',
                    '-loglevel', 'warning',
                    '-i', vdr_url,
                    '-map', '0:v',   # Map Video-Stream
                    '-map', '0:a',   # Map all Audio-tracks
                    '-map_metadata', '0',   # Preserve global Metadata
                    '-map_metadata', '0:p:0' # Preserver Program-Metadata (Channel name / EPG)
                ]

                # IF SCALING
                # Add FFmpeg scaling filter if a target resolution is specified
                scale_filter = parse_size(vsize)
                if scale_filter:
                    # Use scaling filter (scale before encoding with Intel QSV)
                    cmd.extend(['-vf', f'scale={scale_filter}'])

                # IF SCALING
                # Add Intel QSV encoder and remaining parameters
                cmd.extend([
                    '-c:v', vcodec,
                    '-b:v', vbitrate,
                    '-maxrate', vbitrate,
                    '-bufsize', parse_bitrate_multiplier(vbitrate),
                    '-c:a', 'aac',
                    '-b:a', abitrate,
                    '-f', 'mpegts',
                    'pipe:1'
                ])

                process = None
                try:
                    # Start FFmpeg-Process
                    process = subprocess.Popen(
                        cmd,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE,
                        bufsize=10**8
                    )

                    # Send HTTP Header to Client
                    self.send_response(200)
                    self.send_header('Content-Type', 'video/mpeg')
                    self.send_header('Connection', 'close')
                    self.end_headers()

                    # Forward Stream-Data from FFmpeg to Client
                    while True:
                        chunk = process.stdout.read(STREAMDEV_CHUNK_SIZE)
                        if not chunk:
                            break
                        try:
                            self.wfile.write(chunk)
                            self.wfile.flush()
                        except (ConnectionResetError, BrokenPipeError):
                            print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Client {self.client_address[0]} closed connection.")
                            break

                except Exception as e:
                    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Transcoding error: {e}")
                
                finally:
                    # Cleanup: terminate FFmpeg-Prozess if still running
                    if process and process.poll() is None:
                        print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Terminate FFmpeg-Process...")
                        process.terminate()
                        try:
                            process.wait(timeout=3)
                        except subprocess.TimeoutExpired:
                            process.kill()
                    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Terminate Stream-Session for {self.client_address[0]}.")
            else:
                print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Connecting upstream to VDR: {vdr_url}")
                

                req_headers = {}
                # Forward relevant headers if needed (like User-Agent)
                if 'User-Agent' in self.headers:
                    req_headers['User-Agent'] = self.headers['User-Agent']

                req = urllib.request.Request(vdr_url, headers=req_headers)

                try:
                    # Open connection to VDR streamdev server
                    with urllib.request.urlopen(req, timeout=10) as vdr_response:
                        # Send HTTP status code back to client
                        self.send_response(vdr_response.status)
                        
                        # Forward response headers (Content-Type: video/mpeg, etc.)
                        for header, value in vdr_response.headers.items():
                            # Skip hop-by-hop or conflicting headers if necessary
                            if header.lower() in ['transfer-encoding', 'connection']:
                                continue
                            self.send_header(header, value)
                        
                        # Use chunked transfer or standard stream streaming
                        self.send_header('Connection', 'close')
                        self.end_headers()

                        # Stream data chunk by chunk from VDR to the client
                        while True:
                            chunk = vdr_response.read(STREAMDEV_CHUNK_SIZE)
                            if not chunk:
                                break
                            try:
                                self.wfile.write(chunk)
                                self.wfile.flush()
                            except (ConnectionResetError, BrokenPipeError):
                                print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Client {self.client_address[0]} disconnected.")
                                break

                except urllib.error.HTTPError as e:
                    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] VDR Server returned HTTP Error: {e.code} {e.reason}")
                    try:
                        self.send_error(e.code, e.reason)
                    except Exception:
                        pass
                except urllib.error.URLError as e:
                    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Failed to connect to VDR server: {e.reason}")
                    try:
                        self.send_error(502, f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Bad Gateway: Could not connect to VDR server ({e.reason})")
                    except Exception:
                        pass
                except Exception as e:
                    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Proxy error: {e}")
                
                print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Finished stream session for {self.client_address[0]}")

        else:
            self.send_error(404)
    # Suppress default noisy logging of BaseHTTPRequestHandler to keep console clean
    def log_message(self, format, *args):
        return

def parse_bitrate_multiplier(bitrate_str):
    """Calculates a reasonable -bufsize value based on the bitrate string and returns it with unit."""
    try:
        val = float(bitrate_str[:-1])
        unit = bitrate_str[-1].lower()
        if unit == 'm':
            return f"{int(val * 2)}M"
        elif unit == 'k':
            return f"{int(val * 2)}k"
    except Exception:
        pass
    return "4M"

def parse_size(res_str):
    """Converts resolution strings like '720p', '1080p', or '1280x720' into FFmpeg-compatible scaling values."""
    if not res_str:
        return None
    
    res_str = res_str.lower().strip()
    
    # Gängige Shortcuts mappen
    presets = {
        '1080p': '1920:1080',
        '720p': '1280:720',
        '480p': '854:480',
        '576p': '720:576',
        '360p': '640:360',
        '240p': '426:240',
        '144p': '256:144'
    }
    
    if res_str in presets:
        return presets[res_str]
    
    # Manuelle Auflösungen im Format WxH (z.B. 1280x720) unterstützen
    if 'x' in res_str:
        parts = res_str.split('x')
        if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
            return f"{parts[0]}:{parts[1]}"
            
    return None

class ThreadingVDRServer(ThreadingMixIn, HTTPServer):
    """Enable threadened HTTP-Server to handle multiple connections in parallel."""
    daemon_threads = True

def run():
    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Configuration file: {args.config}")
    if ENABLE_AUTH and (AUTH_USERNAME == "" or AUTH_PASSWORD == ""):
        print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Error: Authentication enabled, but username or password is not specified inside config!", file=sys.stderr)
        print("\n[{time.strftime('%Y-%m-%d %H:%M:%S')}] Shutting down proxy server safely.")
        sys.exit(1)
    server_address = (PROXY_LISTEN_IP, PROXY_PORT)
    httpd = ThreadingVDRServer(server_address, VDRProxyHandler)
    if PROXY_PROTOCOL == "https":
        if not SSL_CERT_FILE or not SSL_KEY_FILE:
            print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Error: HTTPS encryption enabled, but ssl_cert_file or ssl_key_file is not specified inside config!", file=sys.stderr)
            sys.exit(1)
        if not os.path.exists(SSL_CERT_FILE) or not os.path.exists(SSL_KEY_FILE):
            print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Error: Certificate file ({SSL_CERT_FILE}) or Key file ({SSL_KEY_FILE}) not found!", file=sys.stderr)
            sys.exit(1)
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.load_cert_chain(certfile=SSL_CERT_FILE, keyfile=SSL_KEY_FILE)
        print(f"\n[{time.strftime('%Y-%m-%d %H:%M:%S')}] Shutting down proxy server safely.")
    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] VDR Proxy web server successfully started on {PROXY_PROTOCOL}://{PROXY_LISTEN_IP}:{PROXY_PORT}...")
    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] Enforcing authentication: {ENABLE_AUTH}")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n[{time.strftime('%Y-%m-%d %H:%M:%S')}] Shutting down proxy server safely.")

if __name__ == '__main__':
    run()